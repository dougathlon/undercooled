{
  "name": "undercooled",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE_PATH=/undercooled/ pnpm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:pages": "VITE_BASE_PATH=/undercooled/ pnpm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:pages && playwright test",
    "test:e2e:built": "playwright test",
    "check": "tsc -b --pretty false && vitest run",
    "verify:release": "pnpm run check && pnpm run build:pages && pnpm run test:e2e:built"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
